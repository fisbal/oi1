{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Office In 1",
  "mainBinaryName": "OfficeIn1",
  "version": "../package.json",
  "identifier": "io.github.fisbal.oi1",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Office In 1",
        "width": 1360,
        "height": 860,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "backgroundColor": "#26262D",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Martin Balla",
    "shortDescription": "Office In 1",
    "longDescription": "One office suite: Letter, Class, Stage, Code+, ProDFos and a Claude copilot in every app.",
    "category": "Productivity",
    "copyright": "Martin Balla",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "French",
          "Spanish",
          "Portuguese",
          "German"
        ],
        "displayLanguageSelector": false
      }
    },
    "android": {
      "minSdkVersion": 24
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "SET_BY_CI_FROM_THE_TAURI_SIGNING_PUBLIC_KEY_SECRET",
      "endpoints": [
        "https://github.com/fisbal/oi1/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
